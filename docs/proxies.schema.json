{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YouTroc proxy pool v1",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "expires_at",
    "status",
    "measurement",
    "stats",
    "sources",
    "proxies"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "ok",
        "degraded",
        "no_working_proxies",
        "sources_unavailable"
      ]
    },
    "measurement": {
      "type": "object"
    },
    "stats": {
      "type": "object",
      "required": [
        "discovered",
        "tested",
        "working"
      ],
      "properties": {
        "discovered": {
          "type": "integer",
          "minimum": 0
        },
        "tested": {
          "type": "integer",
          "minimum": 0
        },
        "working": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "url",
          "ok",
          "accepted"
        ]
      }
    },
    "proxies": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": [
          "host",
          "port",
          "protocol",
          "https_connect",
          "youtube_probe_ok",
          "latency_ms",
          "ttfb_ms",
          "latency_samples_ms",
          "successful_samples",
          "download_mbps",
          "download_bytes",
          "speed_test_ok",
          "checked_at",
          "expires_at",
          "sources"
        ],
        "properties": {
          "host": {
            "type": "string",
            "format": "ipv4"
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "protocol": {
            "const": "HTTP"
          },
          "https_connect": {
            "const": true
          },
          "youtube_probe_ok": {
            "const": true
          },
          "latency_ms": {
            "type": "number",
            "minimum": 0
          },
          "ttfb_ms": {
            "type": "number",
            "minimum": 0
          },
          "latency_samples_ms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "successful_samples": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "download_mbps": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "download_bytes": {
            "enum": [
              0,
              65536
            ]
          },
          "speed_test_ok": {
            "type": "boolean"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    }
  }
}
